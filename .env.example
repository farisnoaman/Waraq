# ---- Build time (compiled into the browser bundle; safe to expose) ----------
VITE_SUPABASE_URL=https://rhqnxzzrxiqgiayvjmgr.supabase.co
# Publishable / anon key from Supabase -> Settings -> API Keys.
# Never put the secret (service_role) key in a VITE_ variable: it is inlined
# into the public JS bundle.
VITE_SUPABASE_ANON_KEY=

# Optional. Leave both empty to use Supabase's own Google provider instead.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_AUTH_PROXY=

# ---- Run time (server only; never expose the service role key) --------------
NEXT_PUBLIC_SUPABASE_URL=https://rhqnxzzrxiqgiayvjmgr.supabase.co
# Secret / service_role key from Supabase -> Settings -> API Keys. Server only.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth user id(s) of the administrator(s), comma separated.
WARAQ_ADMIN_USER_IDS=
PORT=3000
